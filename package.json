{
  "name": "quran-word-by-word",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "fetch-mulk": "tsx scripts/fetch-surah-mulk.ts",
    "import:batch": "node --import tsx scripts/import-batch.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "build:detailed-aids": "node --import tsx scripts/build-detailed-aids.ts",
    "build:next-detailed-aids": "node --import tsx scripts/build-next-detailed-aids.ts",
    "build:detailed-aids-500": "node --import tsx scripts/build-detailed-aids-500.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
